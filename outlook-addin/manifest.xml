<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversion/1.1"
           xsi:type="MailApp">
  <Id>2d23b2d4-70ee-4b5c-9bd1-0e4a8a9d8e31</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>ColixAI</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="ColixAI" />
  <Description DefaultValue="Improve Outlook email drafts with ColixAI." />
  <IconUrl DefaultValue="https://extensions.kbizsoft.com/colix-ai-desktop-app/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="https://extensions.kbizsoft.com/colix-ai-desktop-app/icon-128.png" />
  <SupportUrl DefaultValue="https://extensions.kbizsoft.com/colix-ai-desktop-app/" />
  <AppDomains>
    <AppDomain>https://extensions.kbizsoft.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.3">
      <Set Name="Mailbox" MinVersion="1.3" />
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://extensions.kbizsoft.com/colix-ai-desktop-app/taskpane.html" />
        <RequestedHeight>420</RequestedHeight>
      </DesktopSettings>
    </Form>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://extensions.kbizsoft.com/colix-ai-desktop-app/taskpane.html" />
        <RequestedHeight>420</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteMailbox</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit" />
  </Rule>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Description resid="residDescription" />
      <Requirements>
        <bt:Sets DefaultMinVersion="1.3">
          <bt:Set Name="Mailbox" MinVersion="1.3" />
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="functionFile" />
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="ColixAI.ReadGroup">
                  <Label resid="groupLabel" />
                  <Control xsi:type="Button" id="ColixAI.ReadButton">
                    <Label resid="buttonLabel" />
                    <Supertip>
                      <Title resid="buttonLabel" />
                      <Description resid="buttonDescription" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16" />
                      <bt:Image size="32" resid="icon32" />
                      <bt:Image size="80" resid="icon80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="taskpaneUrl" />
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="ColixAI.ComposeGroup">
                  <Label resid="groupLabel" />
                  <Control xsi:type="Button" id="ColixAI.ComposeButton">
                    <Label resid="buttonLabel" />
                    <Supertip>
                      <Title resid="buttonLabel" />
                      <Description resid="buttonDescription" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16" />
                      <bt:Image size="32" resid="icon32" />
                      <bt:Image size="80" resid="icon80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="taskpaneUrl" />
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="icon16" DefaultValue="https://extensions.kbizsoft.com/colix-ai-desktop-app/icon-16.png" />
          <bt:Image id="icon32" DefaultValue="https://extensions.kbizsoft.com/colix-ai-desktop-app/icon-32.png" />
          <bt:Image id="icon80" DefaultValue="https://extensions.kbizsoft.com/colix-ai-desktop-app/icon-80.png" />
        </bt:Images>
        <bt:Urls>
          <bt:Url id="functionFile" DefaultValue="https://extensions.kbizsoft.com/colix-ai-desktop-app/commands.html" />
          <bt:Url id="taskpaneUrl" DefaultValue="https://extensions.kbizsoft.com/colix-ai-desktop-app/taskpane.html" />
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="groupLabel" DefaultValue="ColixAI" />
          <bt:String id="buttonLabel" DefaultValue="Improve with ColixAI" />
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="residDescription" DefaultValue="Improve Outlook email drafts with ColixAI." />
          <bt:String id="buttonDescription" DefaultValue="Improve the subject and body of this email." />
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
